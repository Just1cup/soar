# Copie para .env e preencha. O .env é gitignored.
# Obrigatórios para Compose; gere um segredo com: openssl rand -base64 48
POSTGRES_PASSWORD=
SOAR_CURSOR_SECRET=
# HTTP local em loopback; use production apenas atrás de HTTPS.
SOAR_ENV=development
SOAR_PROFILE=edge           # edge | standard | scale (docs/soar/08 §5)
SOAR_WEB_PORT=8088
# Diretório persistente opcional; vazio usa ~/.local/share/soar/pg
SOAR_PGDATA=
SOAR_SIEM_NETWORK=elastic-start-local_default # rede Docker externa onde o Elastic está conectado

# Analista local (F-11). Deixe desligado até o Ollama ser alcançável pelo
# processo da API e o port ser aprovado pelo harness Python de qualidade.
SOAR_ASSESSMENT_ENABLED=false
SOAR_OLLAMA_URL=http://host.docker.internal:11434
SOAR_OLLAMA_MODEL=qwen3:8b
SOAR_OLLAMA_NUM_CTX=8192
SOAR_OLLAMA_TIMEOUT_SECONDS=240
# Opcional; sem ele o artefato registra explicitamente que correlação e
# prevalência do SIEM não foram coletadas.
SOAR_ASSESSMENT_ELASTIC_URL=

# Credenciais de leitura do Elasticsearch e resposta no Kibana.
# Guarde somente neste .env local; nunca em config.elastic_url nem no Git.
ELASTIC_AUTH=
KIBANA_AUTH=
